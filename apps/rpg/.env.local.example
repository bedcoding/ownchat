# Copy this file to .env.local for local development. Never commit real secrets.

# Public branding embedded in the client bundle.
NEXT_PUBLIC_PLATFORM_NAME=우리회사이름

# Server-only settings used by the hosted RPG profile.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set to require only when the database host supports TLS.
# DATABASE_SSL=require
# Keep certificate verification enabled unless the provider explicitly requires otherwise.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Vercel functions should keep this small for a shared PostgreSQL plan.
DATABASE_POOL_MAX=3

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ADMIN_SYNC_SECRET=
