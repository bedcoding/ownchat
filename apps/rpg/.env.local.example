# Copy this file to .env.local for local development. Never commit real secrets.

# Public branding embedded in the client bundle.
NEXT_PUBLIC_PLATFORM_NAME=우리회사이름

# Server-only settings used by the hosted RPG profile.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SCHEMA=ownchat
# The current Gabia PostgreSQL endpoint rejected TLS in a connection probe.
DATABASE_SSL=disable
# Use require for a future provider that supports TLS.
# DATABASE_SSL=require
# Keep certificate verification enabled unless the provider explicitly requires otherwise.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Vercel functions should keep this at 1 for the shared Gabia PostgreSQL plan.
DATABASE_POOL_MAX=1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ADMIN_SYNC_SECRET=
