# 공모전용 OpenAI 호스팅 프로필
OWNCHAT_HOSTED=1
OPENAI_API_KEY=sk-...

# 관람자에게 공유할 별도 접근 코드. OpenAI API 키를 넣으면 안 됩니다.
OWNCHAT_DEMO_TOKEN=change-this-to-a-long-random-string

# 무료 일일 토큰 대상 모델 중 하나
OPENAI_MODEL=gpt-5.4-mini

# IP당 10분 요청 횟수(선택)
OWNCHAT_RATE_LIMIT=30

# 서버 프로세스 기준 보수적 일일 예산(선택). 무료 250만보다 여유 있게 낮춘 기본값입니다.
OWNCHAT_DAILY_TOKEN_BUDGET=2000000
